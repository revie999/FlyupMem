{
  "name": "flyupmem",
  "version": "0.5.1",
  "description": "Local-first, zero-cost memory plugin for AI agents",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/revie999/FlyupMem.git"
  },
  "bugs": {
    "url": "https://github.com/revie999/FlyupMem/issues"
  },
  "homepage": "https://github.com/revie999/FlyupMem#readme",
  "bin": {
    "flyupmem": "dist/index.js",
    "flyupmem-mcp": "dist/mcp/entry.js"
  },
  "scripts": {
    "build": "tsc && node -e \"const fs=require('node:fs');fs.mkdirSync('dist/web',{recursive:true});fs.copyFileSync('src/web/dashboard.html','dist/web/dashboard.html')\"",
    "test": "vitest run --maxWorkers 1 --exclude tests/sync.integration.test.ts --exclude tests/benchmark.test.ts && python3 -m unittest tests/hermes_plugin_boundary_test.py -v",
    "test:ts": "vitest run --maxWorkers 1 --exclude tests/sync.integration.test.ts --exclude tests/benchmark.test.ts",
    "test:benchmark": "vitest run --maxWorkers 1 tests/benchmark.test.ts --pool=forks --poolOptions.forks.singleFork=true",
    "test:sync": "vitest run --maxWorkers 1 tests/sync.integration.test.ts",
    "test:hermes-plugin": "python3 -m unittest tests/hermes_plugin_boundary_test.py -v",
    "test:watch": "vitest",
    "dev": "tsx src/index.ts"
  },
  "keywords": [
    "memory",
    "ai-agent",
    "local-first",
    "yaml",
    "agent-memory",
    "mcp",
    "model-context-protocol",
    "sqlite",
    "semantic-search"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^12.9.0",
    "js-yaml": "^4.1.0",
    "typebox": "^1.1.37",
    "zod": "^3.23.0"
  }
}
